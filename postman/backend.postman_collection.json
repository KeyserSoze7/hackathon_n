                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "View 2",
      "item": [
        {
          "name": "Road receipt",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/roads/{{dlpRoadId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('under warranty', () => pm.expect(b.under_dlp).to.be.true);",
                  "pm.test('has work orders + flags', () => { pm.expect(b.work_orders.length).to.be.above(0); pm.expect(b.flags.length).to.be.above(0); });",
                  "pm.test('billed = sum of work orders', () => pm.expect(Math.round(b.total_billed_inr)).to.eql(Math.round(b.work_orders.reduce((s, w) => s + Number(w.cost_inr), 0))));",
                  "pm.test('flags carry evidence row ids', () => b.flags.forEach(f => pm.expect(f.evidence_row_ids.length).to.be.above(0)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Road timeline",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/roads/{{dlpRoadId}}/timeline"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('chronological', () => { for (let i = 1; i < b.length; i++) pm.expect(b[i-1].event_at <= b[i].event_at).to.be.true; });",
                  "pm.test('has work order events', () => pm.expect(b.some(e => e.event_type === 'work_order_completed')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Flag detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/flags/{{flagId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('DLP flag', () => { pm.expect(b.detector).to.eql('DLP_PAID_TWICE'); pm.expect(b.status_label).to.eql('Recoverable under DLP'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Right-of-Reply (201)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/flags/{{flagId}}/replies",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author_role\": \"ward_engineer\",\n  \"author_name\": \"AE Roads (test)\",\n  \"body\": \"MGL utility trench reopened this stretch; requesting contractor be held liable under DLP.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
