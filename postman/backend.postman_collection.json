{
  "info": {
    "name": "Follow the Rupee - Backend (local)",
    "description": "All four views + writes. Start the API (see view3/README.md), then run in order: later requests reuse IDs captured by earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "ward",
      "value": "K/W"
    },
    {
      "key": "flagId",
      "value": ""
    },
    {
      "key": "dlpRoadId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('data loaded', () => { pm.expect(b.work_orders).to.eql(2499); pm.expect(b.flags).to.be.above(0); pm.expect(b.v3_items).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI spec (Swagger)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/openapi.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('all endpoints documented', () => pm.expect(Object.keys(b.paths).length).to.eql(17));",
              "pm.test('every operation tagged + summarized', () => Object.values(b.paths).forEach(p => Object.values(p).forEach(op => { pm.expect(op.tags.length).to.be.above(0); pm.expect(op.summary).to.be.a('string'); })));"
            ]
          }
        }
      ]
    },
    {
      "name": "View 1",
      "item": [
        {
          "name": "City KPIs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/city"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('KPI strip fields', () => { ['total_budget_inr','total_spend_inr','recoverable_dlp_inr','flagged_bills_count','flags_by_detector'].forEach(k => pm.expect(b).to.have.property(k)); });",
                  "pm.test('recoverable <= spend', () => pm.expect(b.recoverable_dlp_inr).to.be.below(b.total_spend_inr));",
                  "pm.test('whole rupees', () => pm.expect(Number.isInteger(b.total_spend_inr)).to.be.true);",
                  "pm.test('extra KPIs', () => { pm.expect(b.rupees_at_stake_total).to.be.at.least(b.recoverable_dlp_inr); pm.expect(b.wards_over_budget).to.be.a('number'); pm.expect(b.under_reported_wards).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Wards (map)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/wards"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('24 wards', () => pm.expect(b.length).to.eql(24));",
                  "pm.test('map colour field', () => b.forEach(w => pm.expect(w.dlp_leakage_rate).to.be.within(0, 1)));",
                  "pm.test('under-reported flag present', () => pm.expect(b.some(w => w.under_reported_flag)).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ward (single, query param)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/wards?ward={{ward}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wards"
              ],
              "query": [
                {
                  "key": "ward",
                  "value": "{{ward}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('one ward object', () => { pm.expect(b).to.be.an('object'); pm.expect(b.ward_code).to.eql(pm.collectionVariables.get('ward')); });",
                  "pm.test('ward-level fields', () => ['budget_inr','spend_inr','recoverable_dlp_inr','dlp_leakage_rate','under_reported_flag','ward_name'].forEach(k => pm.expect(b).to.have.property(k)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ward (single, X-Ward-Code header)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Ward-Code",
                "value": "{{ward}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wards"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('one ward object from header', () => pm.expect(pm.response.json().ward_code).to.eql(pm.collectionVariables.get('ward')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ward (query param wins over header, case-insensitive)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Ward-Code",
                "value": "A"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wards?ward=f/s",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wards"
              ],
              "query": [
                {
                  "key": "ward",
                  "value": "f/s"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('query param used, normalized', () => pm.expect(pm.response.json().ward_code).to.eql('F/S'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ward (unknown, 404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/wards?ward=ZZ",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wards"
              ],
              "query": [
                {
                  "key": "ward",
                  "value": "ZZ"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Flagged queue (all)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/flagged-queue?limit=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "flagged-queue"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "500"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('sorted by rupees at stake', () => { for (let i = 1; i < b.length; i++) pm.expect(b[i-1].rupees_at_stake).to.be.at.least(b[i].rupees_at_stake); });",
                  "pm.test('neutral labels only', () => b.forEach(q => pm.expect(['Needs Explanation','Recoverable under DLP']).to.include(q.status_label)));",
                  "const dlp = b.find(q => q.detectors.includes('DLP_PAID_TWICE'));",
                  "pm.collectionVariables.set('flagId', dlp.flag_ids[0]);",
                  "pm.collectionVariables.set('dlpRoadId', dlp.road_id);",
                  "pm.collectionVariables.set('page1Ids', pm.response.json().slice(0, 5).map(q => q.work_order_id).join(','));"
                ]
              }
            }
          ]
        },
        {
          "name": "Flagged queue (ward, tier 1)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/flagged-queue?ward={{ward}}&tier=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "flagged-queue"
              ],
              "query": [
                {
                  "key": "ward",
                  "value": "{{ward}}"
                },
                {
                  "key": "tier",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('filters applied', () => b.forEach(q => { pm.expect(q.ward_code).to.eql(pm.collectionVariables.get('ward')); pm.expect(q.top_tier).to.eql(1); }));",
                  "pm.test('limit respected', () => pm.expect(b.length).to.be.at.most(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Flagged queue - invalid tier (422)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/flagged-queue?tier=9",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "flagged-queue"
              ],
              "query": [
                {
                  "key": "tier",
                  "value": "9"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ward map (GeoJSON)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/wards/map"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('24 ward polygons', () => { pm.expect(b.type).to.eql('FeatureCollection'); pm.expect(b.features.length).to.eql(24); });",
                  "pm.test('geometry + metrics', () => { const f = b.features[0]; pm.expect(f.geometry.type).to.match(/Polygon/); pm.expect(f.properties).to.have.property('dlp_leakage_rate'); pm.expect(f.properties).to.have.property('ward_name'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Flagged queue - repeat bills with no complaint",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/flagged-queue?detector=REPEAT_BILL_NO_COMPLAINT&limit=500"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('45 repeat bills', () => pm.expect(b.length).to.eql(45));",
                  "pm.test('all carry the detector', () => b.forEach(q => pm.expect(q.detectors).to.include('REPEAT_BILL_NO_COMPLAINT')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ward (single, K-W accepted)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/wards?ward=K-W"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('normalised to K/W', () => pm.expect(pm.response.json().ward_code).to.eql('K/W'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Flagged queue - ward as K-W",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/flagged-queue?ward=K-W&limit=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('rows', () => pm.expect(b.length).to.be.within(1, 5));",
                  "pm.test('all K/W', () => b.forEach(q => pm.expect(q.ward_code).to.eql('K/W')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Flagged queue - page 2 (offset)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/flagged-queue?limit=5&offset=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('5 rows', () => pm.expect(b.length).to.eql(5));",
                  "pm.test('no overlap with page 1', () => pm.expect(pm.collectionVariables.get('page1Ids') || '').to.not.include(b[0].work_order_id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Flagged queue - unknown detector (422)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/flagged-queue?detector=NOPE"
          },
          "event": [
