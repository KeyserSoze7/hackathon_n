        {
          "name": "Budget slider re-solve",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v3/allocate",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"ward_code\": \"{{ward}}\", \"budget_inr\": 500000 }"
