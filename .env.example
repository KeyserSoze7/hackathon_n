# Copy to .env (gitignored) at the repo root and replace the placeholders.
# Supabase dashboard -> Connect -> "Session pooler" URI (port 5432, works on IPv4).
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
