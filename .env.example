# Copy to .env (gitignored) at the repo root and replace the placeholders.
# Supabase dashboard -> Connect -> "Session pooler" URI (port 5432, works on IPv4).
# URL-encode special characters in the password: @ -> %40, # -> %23, / -> %2F
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Claude (draft-notice, citizen-query). Without it the endpoints return filled templates.
ANTHROPIC_API_KEY=

# Photo uploads -> Supabase Storage (bucket report-photos) over S3.
# Supabase dashboard -> Project Settings -> Storage -> S3 access keys -> New access key.
# Project URL and region are derived from DATABASE_URL. Without these keys, photos are saved to ./uploads instead.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Admin / ward-officer sessions (POST /api/admin/login). Default 12 hours.
ADMIN_SESSION_HOURS=12
