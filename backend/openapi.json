          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AllocateReq": {
        "properties": {
          "ward_code": {
            "type": "string",
            "title": "Ward Code"
          },
          "budget_inr": {
            "type": "number",
            "maximum": 500000000.0,
            "minimum": 0.0,
            "title": "Budget Inr"
          }
        },
        "type": "object",
        "required": [
          "ward_code",
          "budget_inr"
        ],
        "title": "AllocateReq",
        "examples": [
          {
            "budget_inr": 500000,
            "ward_code": "K/W"
          }
        ]
      },
      "CitizenReportReq": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "still_broken",
              "verified_fixed",
              "new_issue"
            ],
            "title": "Kind"
          },
          "input_mode": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "photo",
              "qr"
            ],
            "title": "Input Mode",
            "default": "text"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "en",
                  "hi",
                  "mr"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "photo_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Url"
          },
          "road_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Road Id"
          },
          "work_order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Work Order Id"
          },
          "matched_locality": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Locality"
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "CitizenReportReq",
        "examples": [
          {
            "input_mode": "voice",
            "kind": "still_broken",
            "language": "hi",
            "road_id": "RD0153",
            "text": "Andheri subway ke bahar wapas khadda ho gaya"
          }
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReplyReq": {
        "properties": {
          "author_role": {
            "type": "string",
            "enum": [
              "ward_engineer",
              "contractor",
              "other"
            ],
            "title": "Author Role"
          },
          "author_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Author Name"
          },
          "body": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "author_role",
          "body"
        ],
        "title": "ReplyReq",
        "examples": [
          {
            "author_name": "AE Roads K/W",
            "author_role": "ward_engineer",
            "body": "MGL utility trench reopened this stretch; contractor liable under DLP."
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Meta",
      "description": "Health check."
    },
    {
      "name": "View 1: City & Ward Overview",
      "description": "KPI strip, ward map, flagged bills queue."
    },
    {
      "name": "View 2: Road Story",
      "description": "Rupee receipt, connected trail, flags, Right-of-Reply."
    },
    {
      "name": "View 3: Scorecard & Next Rupee",
      "description": "Context-adjusted contractor scorecard, budget allocation, live slider."
    },
    {
      "name": "View 4: Citizen Layer",
      "description": "Landmark lookup and citizen reports with accountability tracker."
    }
  ]
}