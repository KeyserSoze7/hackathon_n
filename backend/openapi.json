    "/api/wards": {
      "get": {
        "tags": [
          "View 1: City & Ward Overview"
        ],
        "summary": "All wards, or one ward via ?ward= / X-Ward-Code",
        "description": "View 1 ward map: all wards as a list, or one ward as an object when a ward code is given\n(query param or X-Ward-Code header). Colour the map by dlp_leakage_rate; join to wards.geojson on ward_code.",
        "operationId": "ward_list_api_wards_get",
        "parameters": [
          {
            "name": "ward",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ward code, e.g. K/W. Returns that ward only.",
              "title": "Ward"
            },
            "description": "Ward code, e.g. K/W. Returns that ward only."
          },
          {
            "name": "x-ward-code",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Same as ?ward=; the query param wins if both are sent.",
              "title": "X-Ward-Code"
            },
            "description": "Same as ?ward=; the query param wins if both are sent."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/flagged-queue": {
      "get": {
        "tags": [
          "View 1: City & Ward Overview"
        ],
        "summary": "Flagged bills ranked by rupees at stake",
        "description": "View 1 flagged bills, ranked by rupees at stake. ?ward=K/W&tier=1&limit=20",
        "operationId": "flagged_queue_api_flagged_queue_get",
        "parameters": [
          {
            "name": "ward",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Ward code filter",
              "examples": [
                "K/W"
              ],
              "title": "Ward"
            },
            "description": "Ward code filter"
          },
          {
            "name": "tier",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 3,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Top tier filter: 1 contractual, 2 implausible, 3 lead",
              "title": "Tier"
            },
            "description": "Top tier filter: 1 contractual, 2 implausible, 3 lead"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
