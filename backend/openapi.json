    "/api/lookup": {
      "get": {
        "tags": [
          "View 4: Citizen Layer"
        ],
        "summary": "Free-text landmark/road lookup -> road receipt",
        "description": "View 4 deterministic lookup: free text -> road receipt.\nTries a road name in the text first (\"Andheri subway ke bahar...\"), then any locality name/alias/Devanagari.\nFuzzy/vernacular parsing beyond this is the Claude /api/citizen-query layer's job.",
        "operationId": "lookup_api_lookup_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "Free text: road name, locality, alias or Devanagari",
              "examples": [
                "Andheri subway ke bahar wapas khadda ho gaya, paisa kahan gaya?"
              ],
              "title": "Q"
            },
            "description": "Free text: road name, locality, alias or Devanagari"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/citizen-reports": {
      "post": {
        "tags": [
          "View 4: Citizen Layer"
        ],
        "summary": "Submit citizen report (server sets tracker status)",
        "description": "View 4 report. Tracker status is set deterministically here (anon clients cannot set it).",
        "operationId": "add_citizen_report_api_citizen_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CitizenReportReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
