{
  "openapi": "3.1.0",
  "info": {
    "title": "Follow the Rupee: Backend",
    "description": "Pre-Payment Audit Gate + Citizen Rupee Receipt for Mumbai monsoon road repairs (synthetic dataset).\n\nEvery number is computed by the audit pipelines (`pipeline/build.py`, `view3/view3_pipeline.py`); endpoints only select and shape. Flags are labelled *Needs Explanation* or *Recoverable under DLP*, and every flag carries `evidence_row_ids`. Amounts are whole rupees (INR). No login.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v3/contractors": {
      "get": {
        "tags": [
          "View 3: Scorecard & Next Rupee"
        ],
        "summary": "Contractor scorecard (context-adjusted)",
        "operationId": "contractors_api_v3_contractors_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
