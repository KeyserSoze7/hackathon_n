    "/api/citizen-reports/{report_id}": {
      "get": {
        "tags": [
          "View 4: Citizen Layer"
        ],
        "summary": "Citizen report status + tracker",
        "operationId": "citizen_report_api_citizen_reports__report_id__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
